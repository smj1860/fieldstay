# Copy to load-tests/.env.load (gitignored — never commit real values here).
#
# Base URL for every load test script below. Defaults to a local dev server
# if unset. Point this at a preview/staging deployment to load test a real
# environment — never point it at the production URL without checking with
# whoever owns Upstash/Vercel usage first, since these scripts intentionally
# generate sustained concurrent traffic.
LOAD_BASE_URL=http://localhost:3000

# Fake-but-well-formed tokens used only to exercise the rate limiter on
# TOKEN_ROUTES (see proxy.ts) — these are expected to 404, the tests only
# care about the response status/timing, not real data. No real
# work-order/owner-portal/vendor-connect token should ever be put here.
LOAD_WORK_ORDER_TOKEN=00000000-0000-0000-0000-000000000000
LOAD_OWNER_PORTAL_TOKEN=00000000-0000-0000-0000-000000000000
LOAD_VENDOR_CONNECT_TOKEN=00000000-0000-0000-0000-000000000000
